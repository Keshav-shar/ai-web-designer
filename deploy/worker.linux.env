# Paths and runtime settings for the engine on the Linux server (non-secret). Installed by bootstrap.sh as
# /srv/cosmogon/worker.env and read by the systemd service. The environment wins over worker/.env, so these override
# the Windows defaults in the code; the keys (Supabase, OpenRouter, Groq, ...) stay in /srv/cosmogon/studio/worker/.env.
SERPMAN_SRC=/srv/cosmogon/lab
SERPMAN_DATA=/srv/cosmogon/data/serpman_data
SERPMAN_P1=/srv/cosmogon/data/serpman_data/ui_drafts/p1
SERPMAN_TMP=/srv/cosmogon/tmp
HF_HOME=/srv/cosmogon/cache/huggingface
CC_OV_DIR=/srv/cosmogon/cache/ov
PLAYWRIGHT_BROWSERS_PATH=/srv/cosmogon/cache/ms-playwright
LANDING_ENV_FILE=/srv/cosmogon/studio/worker/.env
LANDING_OUT=/srv/cosmogon/studio/out/_landing
LANDING_CACHE=/srv/cosmogon/studio/out/_agents/cache
LANDING_LEDGER=/srv/cosmogon/studio/out/_agents/quota.json
LANDING_UNAVAIL=/srv/cosmogon/studio/out/_agents/unavailable.json
# 2 vCPU / 2 GB: keep torch and BLAS to the two cores, and keep glibc's per-thread heaps few
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
MALLOC_ARENA_MAX=2
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
